#!/bin/sh
set -eu

load_secret() {
  variable_name="$1"
  file_variable_name="${variable_name}_FILE"
  eval "secret_file=\${${file_variable_name}:-}"
  [ -n "${secret_file}" ] || return 0
  [ -r "${secret_file}" ] || {
    printf 'Secret file is not readable: %s\n' "${secret_file}" >&2
    exit 1
  }
  secret_value="$(cat "${secret_file}")"
  export "${variable_name}=${secret_value}"
  unset "${file_variable_name}"
}

load_secret MYSQL_ROOT_PASSWORD
load_secret MYSQL_PASSWORD

mysql_uid="$(id -u mysql)"
data_uid="$(stat -c '%u' /var/lib/mysql)"
if [ "${data_uid}" != "${mysql_uid}" ]; then
  chown -R mysql:mysql /var/lib/mysql
fi

exec setpriv --reuid=mysql --regid=mysql --init-groups /docker-entrypoint.sh "$@"
