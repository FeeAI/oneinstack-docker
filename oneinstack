#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROGRAM_NAME="oneinstack"
PROGRAM_VERSION="$(<"${SCRIPT_DIR}/VERSION")"
readonly PROGRAM_NAME PROGRAM_VERSION
DEFAULT_DATA_DIR="${ONEINSTACK_DEFAULT_DATA_DIR:-${SCRIPT_DIR}/data}"
ENV_FILE="${ONEINSTACK_ENV_FILE:-${SCRIPT_DIR}/.env}"
COMPOSE_FILE="${SCRIPT_DIR}/compose.yaml"
COMPOSE=()
PROFILES=()

# shellcheck source=scripts/env.sh
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/scripts/env.sh"

log() {
  printf '[%s] %s\n' "${PROGRAM_NAME}" "$*"
}

fail() {
  printf '[%s] Error: %s\n' "${PROGRAM_NAME}" "$*" >&2
  exit 1
}

