absolute_path() {
  local path="$1"
  local directory
  local filename

  if [[ "${path}" == /* ]]; then
    printf '%s\n' "${path}"
    return
  fi

  directory="$(dirname -- "${path}")"
  filename="$(basename -- "${path}")"
  directory="$(CDPATH='' cd -- "${directory}" 2>/dev/null && pwd)" ||
    fail "Environment file directory does not exist: ${directory}"
  printf '%s/%s\n' "${directory}" "${filename}"
}

detect_compose() {
  command -v docker >/dev/null 2>&1 ||
    fail "Docker is not installed or is not available in PATH."

  if docker compose version >/dev/null 2>&1; then
    COMPOSE=(docker compose)
  elif command -v docker-compose >/dev/null 2>&1; then
    COMPOSE=(docker-compose)
  else
    fail "Docker Compose is not installed."
  fi
}

run_compose() {
  local -a compose_args
  local profile

  if ((${#COMPOSE[@]} == 0)); then
    detect_compose
  fi

  compose_args=(
    "${COMPOSE[@]}"
    --project-directory "${SCRIPT_DIR}"
    --env-file "${ENV_FILE}"
    --file "${COMPOSE_FILE}"
  )
  if ((${#PROFILES[@]} > 0)); then
    for profile in "${PROFILES[@]}"; do
      compose_args+=(--profile "${profile}")
    done
  fi
  compose_args+=("$@")

  "${compose_args[@]}"
}

require_env_file() {
  [[ -f "${ENV_FILE}" ]] ||
    fail "Environment file not found: ${ENV_FILE}. Run './oneinstack init' first."
  validate_managed_data_dir
  ensure_secret_files
}

validate_data_dir() {
  local directory="$1"

  [[ "${directory}" == /* ]] ||
    fail "The host data directory must be an absolute path."
  case "${directory}" in
    / | /bin | /boot | /dev | /etc | /home | /lib | /lib64 | /opt | /proc | /root | /run | /sbin | /srv | /sys | /tmp | /usr | /var)
      fail "Refusing unsafe host data directory: ${directory}"
      ;;
  esac
}

data_dir() {
  local directory

  directory="$(env_get "${ENV_FILE}" ONEINSTACK_DATA_DIR)"
  [[ -n "${directory}" ]] || fail "ONEINSTACK_DATA_DIR is not configured."
  validate_data_dir "${directory}"
  printf '%s\n' "${directory%/}"
}

validate_managed_data_dir() {
  local directory
  local marker

  directory="$(data_dir)"
  marker="${directory}/.oneinstack-managed"
  [[ -f "${marker}" ]] ||
    fail "Managed data marker is missing: ${marker}"
  [[ "$(head -n 1 "${marker}")" == "oneinstack-data-v1" ]] ||
    fail "Managed data marker is invalid: ${marker}"
}

ensure_secret_file() {
  local filename="$1"
  local legacy_key="$2"
  local path_key="$3"
  local missing_policy="${4:-fail}"
  local secrets_directory
  local secret_file
  local legacy_value

  secret_file="$(secret_path "${filename}" "${path_key}")"
  secrets_directory="$(dirname -- "${secret_file}")"
  prepare_secret_directory "${secrets_directory}"
  if [[ -z "$(env_get "${ENV_FILE}" "${path_key}")" ]]; then
    env_set "${ENV_FILE}" "${path_key}" "${secret_file}"
  fi

  if [[ -s "${secret_file}" ]]; then
    if is_managed_secret_path "${secret_file}"; then
      secure_secret_permissions "${secret_file}"
    else
      [[ -r "${secret_file}" ]] ||
        fail "Configured secret is not readable: ${secret_file}"
    fi
    return
  fi

  legacy_value="$(env_get "${ENV_FILE}" "${legacy_key}")"
  if [[ -z "${legacy_value}" || "${legacy_value}" == change-me-* ]]; then
    [[ "${missing_policy}" == "generate" ]] ||
      fail "Secret is missing: ${secret_file}"
    legacy_value="$(random_secret)"
    log "Generated missing ${filename} secret at ${secret_file}"
  fi
  printf '%s' "${legacy_value}" >"${secret_file}"
  secure_secret_permissions "${secret_file}"
  env_set "${ENV_FILE}" "${legacy_key}" ""
  log "Migrated ${legacy_key} from .env to ${secret_file}"
}

ensure_secret_files() {
  ensure_secret_file database_password DATABASE_PASSWORD DATABASE_PASSWORD_FILE
  ensure_secret_file mysql_root_password MYSQL_ROOT_PASSWORD MYSQL_ROOT_PASSWORD_FILE
  ensure_secret_file mongodb_root_password MONGODB_ROOT_PASSWORD MONGODB_ROOT_PASSWORD_FILE
  ensure_secret_file redis_password REDIS_PASSWORD REDIS_PASSWORD_FILE
  ensure_secret_file apisix_admin_key APISIX_ADMIN_KEY APISIX_ADMIN_KEY_FILE generate
}

secret_path() {
  local filename="$1"
  local path_key="$2"
  local default_path
  local configured_path

  default_path="$(data_dir)/secrets/${filename}"
  configured_path="$(env_get "${ENV_FILE}" "${path_key}")"
  [[ -z "${configured_path}" ]] && configured_path="${default_path}"
  validate_secret_file_path "${configured_path}" "${path_key}"
  printf '%s\n' "${configured_path}"
}

validate_secret_file_path() {
  local secret_file="$1"
  local label="${2:-Secret path}"
  local parent

  [[ "${secret_file}" == /* ]] || fail "${label} must be an absolute path."
  parent="$(dirname -- "${secret_file}")"
  case "${parent}" in
    / | /bin | /boot | /dev | /etc | /home | /lib | /lib64 | /opt | /proc | /root | /run | /sbin | /srv | /sys | /tmp | /usr | /var)
      fail "Refusing unsafe secret file path: ${secret_file}"
      ;;
  esac
  [[ ! -d "${secret_file}" ]] ||
    fail "Secret file path points to a directory: ${secret_file}"
}

is_managed_secret_path() {
  [[ "$(dirname -- "$1")" == "$(data_dir)/secrets" ]]
}

prepare_secret_directory() {
  local secrets_directory="$1"
  local created=0
  local app_uid
  local app_gid

  if [[ ! -d "${secrets_directory}" ]]; then
    mkdir -p "${secrets_directory}"
    created=1
  fi
  if ((created == 1)) || [[ "${secrets_directory}" == "$(data_dir)/secrets" ]]; then
    chmod 0700 "${secrets_directory}"
    app_uid="$(env_get "${ENV_FILE}" APP_UID)"
    app_gid="$(env_get "${ENV_FILE}" APP_GID)"
    if ((EUID == 0)) &&
      [[ "${app_uid}" =~ ^[0-9]+$ && "${app_gid}" =~ ^[0-9]+$ ]]; then
      chown "${app_uid}:${app_gid}" "${secrets_directory}"
    fi
  fi
}

secure_secret_permissions() {
  local secret_file="$1"
  local secrets_directory
  local app_uid
  local app_gid

  secrets_directory="$(dirname -- "${secret_file}")"
  chmod 0600 "${secret_file}"
  app_uid="$(env_get "${ENV_FILE}" APP_UID)"
  app_gid="$(env_get "${ENV_FILE}" APP_GID)"
  if ((EUID == 0)) &&
    [[ "${app_uid}" =~ ^[0-9]+$ && "${app_gid}" =~ ^[0-9]+$ ]]; then
    chown "${app_uid}:${app_gid}" "${secret_file}"
    if is_managed_secret_path "${secret_file}"; then
      chown "${app_uid}:${app_gid}" "${secrets_directory}"
    fi
  fi
}

secret_name_to_fields() {
  case "$1" in
    database | database-password)
      printf '%s\n' 'database_password|DATABASE_PASSWORD|DATABASE_PASSWORD_FILE'
      ;;
    mysql-root | mysql-root-password)
      printf '%s\n' 'mysql_root_password|MYSQL_ROOT_PASSWORD|MYSQL_ROOT_PASSWORD_FILE'
      ;;
    mongodb-root | mongodb-root-password)
      printf '%s\n' 'mongodb_root_password|MONGODB_ROOT_PASSWORD|MONGODB_ROOT_PASSWORD_FILE'
      ;;
    redis | redis-password)
      printf '%s\n' 'redis_password|REDIS_PASSWORD|REDIS_PASSWORD_FILE'
      ;;
    apisix | apisix-admin | apisix-admin-key)
      printf '%s\n' 'apisix_admin_key|APISIX_ADMIN_KEY|APISIX_ADMIN_KEY_FILE'
      ;;
    *) fail "Unknown secret name: $1 (use database, mysql-root, mongodb-root, redis or apisix)." ;;
  esac
}

secret_in_use() {
  local name="$1"
  local directory
  local item
  local -a directories=()

  case "${name}" in
    database_password)
      directories=(mysql mariadb percona postgresql mongodb)
      ;;
    mysql_root_password)
      directories=(mysql mariadb percona)
      ;;
    mongodb_root_password) directories=(mongodb) ;;
    redis_password) directories=(redis) ;;
    apisix_admin_key) directories=(apisix/etcd) ;;
    *) return 1 ;;
  esac
  for item in "${directories[@]}"; do
    directory="$(data_dir)/${item}"
    if [[ -d "${directory}" ]] &&
      find "${directory}" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
      return 0
    fi
  done
  return 1
}

seed_data_file() {
  local source="$1"
  local destination="$2"

  if [[ ! -e "${destination}" ]]; then
    mkdir -p "$(dirname -- "${destination}")"
    cp "${source}" "${destination}"
  fi
}

random_secret() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 24
  else
    od -An -N24 -tx1 /dev/urandom | tr -d '[:space:]'
  fi
}

manage_secrets() {
  local action="${1:-list}"
  local fields
  local name
  local filename
  local legacy_key
  local path_key
  local destination
  local source=""
  local mode=""
  local value
  local temporary_file
  local configured_path=""
  local after_rotation=0
  local was_in_use=0

  case "${action}" in
    list | status)
      for name in database mysql-root mongodb-root redis apisix; do
        fields="$(secret_name_to_fields "${name}")"
        IFS='|' read -r filename legacy_key path_key <<<"${fields}"
        destination="$(secret_path "${filename}" "${path_key}")"
        if [[ -s "${destination}" ]]; then
          printf '%-12s configured %s\n' "${name}" "${destination}"
        else
          printf '%-12s missing    %s\n' "${name}" "${destination}"
        fi
      done
      ;;
    set)
      name="${2:-}"
      [[ -n "${name}" ]] ||
        fail "Usage: secret set NAME [--path FILE] --file FILE|--stdin|--generate [--after-rotation]"
      fields="$(secret_name_to_fields "${name}")"
      IFS='|' read -r filename legacy_key path_key <<<"${fields}"
      shift 2
      while (($# > 0)); do
        case "$1" in
          --file)
            [[ -z "${mode}" && -n "${2:-}" ]] ||
              fail "secret set accepts exactly one value source."
            source="$(absolute_path "$2")"
            mode="file"
            shift 2
            ;;
          --stdin)
            [[ -z "${mode}" ]] ||
              fail "secret set accepts exactly one value source."
            mode="stdin"
            shift
            ;;
          --generate)
            [[ -z "${mode}" ]] ||
              fail "secret set accepts exactly one value source."
            mode="generate"
            shift
            ;;
          --path)
            [[ -n "${2:-}" ]] || fail "--path requires an absolute file path."
            configured_path="$(absolute_path "$2")"
            shift 2
            ;;
          --after-rotation)
            after_rotation=1
            shift
            ;;
          *)
            fail "Usage: secret set NAME [--path FILE] --file FILE|--stdin|--generate [--after-rotation]"
            ;;
        esac
      done
      [[ -n "${mode}" ]] || fail "Choose --file, --stdin or --generate."
      if secret_in_use "${filename}"; then
        was_in_use=1
        ((after_rotation == 1)) ||
          fail "Refusing to replace ${name}: service data exists. Rotate the account first, then repeat with --after-rotation."
      fi

      if [[ -n "${configured_path}" ]]; then
        destination="${configured_path}"
      else
        destination="$(secret_path "${filename}" "${path_key}")"
      fi
      validate_secret_file_path "${destination}" "${path_key}"
      prepare_secret_directory "$(dirname -- "${destination}")"
      case "${mode}" in
        file)
          [[ -f "${source}" ]] || fail "Secret source file not found: ${source}"
          value="$(cat "${source}")"
          ;;
        stdin) value="$(cat)" ;;
        generate) value="$(random_secret)" ;;
      esac
      [[ -n "${value}" ]] || fail "Secret value must not be empty."
      [[ "${value}" != *$'\n'* && "${value}" != *$'\r'* ]] ||
        fail "Secret value must be a single line."

      temporary_file="$(mktemp "$(dirname -- "${destination}")/.oneinstack-secret.XXXXXX")"
      printf '%s' "${value}" >"${temporary_file}"
      chmod 0600 "${temporary_file}"
      mv "${temporary_file}" "${destination}"
      secure_secret_permissions "${destination}"
      env_set "${ENV_FILE}" "${path_key}" "${destination}"
      env_set "${ENV_FILE}" "${legacy_key}" ""
      printf '[%s] Updated %s at %s\n' "${PROGRAM_NAME}" "${name}" "${destination}"
      if ((was_in_use == 1)); then
        printf '[%s] Recreate affected application and service containers so the new secret mount is active.\n' \
          "${PROGRAM_NAME}"
      fi
      ;;
    *)
      fail "Usage: secret {list|status|set NAME [--path FILE] --file FILE|--stdin|--generate [--after-rotation]}"
      ;;
  esac
}

initialize() {
  local host_data_dir="${DEFAULT_DATA_DIR}"
  local env_directory
  local temporary_file
  local mysql_root_password
  local database_password
  local redis_password
  local mongodb_root_password
  local app_uid
  local app_gid

  while (($# > 0)); do
    case "$1" in
      --data-dir)
        host_data_dir="${2:?--data-dir requires an absolute path}"
        shift 2
        ;;
      *) fail "Unknown init option: $1" ;;
    esac
  done

  validate_data_dir "${host_data_dir}"
  host_data_dir="${host_data_dir%/}"
  [[ ! -e "${ENV_FILE}" ]] ||
    fail "Environment file already exists: ${ENV_FILE}"

  env_directory="$(dirname -- "${ENV_FILE}")"
  mkdir -p "${env_directory}"
  mkdir -p "${host_data_dir}" ||
    fail "Cannot create host data directory: ${host_data_dir}"
  host_data_dir="$(CDPATH='' cd -- "${host_data_dir}" && pwd -P)"
  validate_data_dir "${host_data_dir}"
  if [[ -f "${host_data_dir}/.oneinstack-managed" ]]; then
    [[ "$(head -n 1 "${host_data_dir}/.oneinstack-managed")" == "oneinstack-data-v1" ]] ||
      fail "The existing host data directory has an invalid managed marker."
  elif find "${host_data_dir}" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
    fail "Refusing to adopt a non-empty host data directory without a managed marker."
  fi
  mkdir -p \
    "${host_data_dir}/acme/.well-known/acme-challenge" \
    "${host_data_dir}/apisix/etcd" \
    "${host_data_dir}/backups" \
    "${host_data_dir}/caddy/config" \
    "${host_data_dir}/caddy/data" \
    "${host_data_dir}/certs" \
    "${host_data_dir}/config/apache" \
    "${host_data_dir}/config/caddy/sites" \
    "${host_data_dir}/config/nginx" \
    "${host_data_dir}/config/openresty" \
    "${host_data_dir}/config/tengine" \
    "${host_data_dir}/ftp" \
    "${host_data_dir}/logs/apache" \
    "${host_data_dir}/logs/caddy" \
    "${host_data_dir}/logs/nginx" \
    "${host_data_dir}/mariadb" \
    "${host_data_dir}/mongodb" \
    "${host_data_dir}/mysql" \
    "${host_data_dir}/npm/data" \
    "${host_data_dir}/npm/letsencrypt" \
    "${host_data_dir}/percona" \
    "${host_data_dir}/postgresql" \
    "${host_data_dir}/redis" \
    "${host_data_dir}/secrets" \
    "${host_data_dir}/sites" \
    "${host_data_dir}/tomcat/webapps/ROOT" \
    "${host_data_dir}/www/default" ||
    fail "Cannot create host data directory: ${host_data_dir}"

  seed_data_file \
    "${SCRIPT_DIR}/nginx/conf.d/default.conf" \
    "${host_data_dir}/config/nginx/default.conf"
  seed_data_file \
    "${SCRIPT_DIR}/tengine/conf.d/default.conf" \
    "${host_data_dir}/config/tengine/default.conf"
  seed_data_file \
    "${SCRIPT_DIR}/openresty/conf.d/default.conf" \
    "${host_data_dir}/config/openresty/default.conf"
  seed_data_file \
    "${SCRIPT_DIR}/apache/conf.d/default.conf" \
    "${host_data_dir}/config/apache/default.conf"
  seed_data_file \
    "${SCRIPT_DIR}/www/default/index.php" \
    "${host_data_dir}/www/default/index.php"
  seed_data_file \
    "${SCRIPT_DIR}/tomcat/webapps/ROOT/index.jsp" \
    "${host_data_dir}/tomcat/webapps/ROOT/index.jsp"
  printf 'oneinstack-data-v1\n' >"${host_data_dir}/.oneinstack-managed"
  chmod 0600 "${host_data_dir}/.oneinstack-managed"
  temporary_file="$(mktemp "${env_directory}/.oneinstack.env.XXXXXX")"
  trap 'rm -f "${temporary_file}"' RETURN

  mysql_root_password="$(random_secret)"
  database_password="$(random_secret)"
  redis_password="$(random_secret)"
  mongodb_root_password="$(random_secret)"
  apisix_admin_key="$(random_secret)"
  app_uid="${SUDO_UID:-$(id -u)}"
  app_gid="${SUDO_GID:-$(id -g)}"
  [[ "${app_uid}" != "0" ]] || app_uid=1000
  [[ "${app_gid}" != "0" ]] || app_gid=1000
  printf '%s' "${database_password}" >"${host_data_dir}/secrets/database_password"
  printf '%s' "${mysql_root_password}" >"${host_data_dir}/secrets/mysql_root_password"
  printf '%s' "${mongodb_root_password}" >"${host_data_dir}/secrets/mongodb_root_password"
  printf '%s' "${redis_password}" >"${host_data_dir}/secrets/redis_password"
  printf '%s' "${apisix_admin_key}" >"${host_data_dir}/secrets/apisix_admin_key"
  chmod 0700 "${host_data_dir}/secrets"
  chmod 0700 "${host_data_dir}/apisix/etcd"
  chmod 0600 "${host_data_dir}/secrets/"*
  if ((EUID == 0)); then
    chown -R "${app_uid}:${app_gid}" \
      "${host_data_dir}/ftp" \
      "${host_data_dir}/secrets" \
      "${host_data_dir}/tomcat/webapps" \
      "${host_data_dir}/www"
  fi

  awk \
    -v app_uid="${app_uid}" \
    -v app_gid="${app_gid}" \
    -v data_dir="${host_data_dir}" \
    '
      /^APP_UID=/ { print "APP_UID=" app_uid; next }
      /^APP_GID=/ { print "APP_GID=" app_gid; next }
      /^ONEINSTACK_DATA_DIR=/ { print "ONEINSTACK_DATA_DIR=" data_dir; next }
      /^MYSQL_ROOT_PASSWORD=/ { print "MYSQL_ROOT_PASSWORD="; next }
      /^DATABASE_PASSWORD=/ { print "DATABASE_PASSWORD="; next }
      /^REDIS_PASSWORD=/ { print "REDIS_PASSWORD="; next }
      /^MONGODB_ROOT_PASSWORD=/ { print "MONGODB_ROOT_PASSWORD="; next }
      /^DATABASE_PASSWORD_FILE=/ { print "DATABASE_PASSWORD_FILE=" data_dir "/secrets/database_password"; next }
      /^MYSQL_ROOT_PASSWORD_FILE=/ { print "MYSQL_ROOT_PASSWORD_FILE=" data_dir "/secrets/mysql_root_password"; next }
      /^MONGODB_ROOT_PASSWORD_FILE=/ { print "MONGODB_ROOT_PASSWORD_FILE=" data_dir "/secrets/mongodb_root_password"; next }
      /^REDIS_PASSWORD_FILE=/ { print "REDIS_PASSWORD_FILE=" data_dir "/secrets/redis_password"; next }
      /^APISIX_ADMIN_KEY_FILE=/ { print "APISIX_ADMIN_KEY_FILE=" data_dir "/secrets/apisix_admin_key"; next }
      { print }
    ' "${SCRIPT_DIR}/.env.example" >"${temporary_file}"

  chmod 0600 "${temporary_file}"
  mv "${temporary_file}" "${ENV_FILE}"
  trap - RETURN

  log "Created ${ENV_FILE}"
  log "Host data directory: ${host_data_dir}"
  log "Review the environment file, then run './oneinstack up'."
}

doctor() {
  local failed=0

  if command -v docker >/dev/null 2>&1; then
    log "Docker CLI: $(docker --version)"
  else
    printf '[%s] Missing: Docker CLI\n' "${PROGRAM_NAME}" >&2
    failed=1
  fi

  if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    COMPOSE=(docker compose)
    log "Compose: $(docker compose version)"
  elif command -v docker-compose >/dev/null 2>&1; then
    COMPOSE=(docker-compose)
    log "Compose: $(docker-compose version)"
  else
    printf '[%s] Missing: Docker Compose\n' "${PROGRAM_NAME}" >&2
    failed=1
  fi

  if command -v docker >/dev/null 2>&1; then
    if docker info >/dev/null 2>&1; then
      log "Docker daemon: reachable"
    else
      printf '[%s] Unavailable: Docker daemon\n' "${PROGRAM_NAME}" >&2
      failed=1
    fi
  fi

  if [[ -f "${ENV_FILE}" ]]; then
    log "Environment: ${ENV_FILE}"
    if [[ -f "$(data_dir)/.oneinstack-managed" ]]; then
      log "Host data directory: $(data_dir)"
      ensure_secret_files
      validate_runtime_selection
      log "Runtime selection: valid"
    else
      printf '[%s] Invalid: managed data marker is missing under %s\n' \
        "${PROGRAM_NAME}" "$(data_dir)" >&2
      failed=1
    fi
  else
    printf '[%s] Missing: %s (run init)\n' "${PROGRAM_NAME}" "${ENV_FILE}" >&2
    failed=1
  fi

  if ((${#COMPOSE[@]} > 0)) && [[ -f "${ENV_FILE}" ]]; then
    if run_compose config --quiet; then
      log "Compose configuration: valid"
    else
      printf '[%s] Invalid: Compose configuration\n' "${PROGRAM_NAME}" >&2
      failed=1
    fi
  fi

  return "${failed}"
}

selected_web_service() {
  env_get "${ENV_FILE}" WEB_ENGINE nginx
}

selected_database_service() {
  env_get "${ENV_FILE}" DATABASE_ENGINE mysql
}

database_version_key() {
  case "$1" in
    mysql) printf '%s\n' MYSQL_VERSION ;;
    mariadb) printf '%s\n' MARIADB_VERSION ;;
    percona) printf '%s\n' PERCONA_VERSION ;;
    postgresql) printf '%s\n' POSTGRES_VERSION ;;
    mongodb) printf '%s\n' MONGODB_VERSION ;;
    *) return 1 ;;
  esac
}

validate_image_tag() {
  local value="$1"
  local label="$2"

  if [[ ! "${value}" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ ]] ||
    ((${#value} > 128)); then
    fail "${label} must be a valid Docker image tag."
  fi
}

validate_supported_php_version() {
  case "$1" in
    8.2 | 8.3 | 8.4 | 8.5) ;;
    *) fail "Supported PHP versions are 8.2, 8.3, 8.4 and 8.5." ;;
  esac
}

validate_mysql_lts_version() {
  [[ "$1" =~ ^(8\.4|9\.7)(\.[0-9]+)?(-[A-Za-z0-9._-]+)?$ ]] ||
    fail "MySQL must use a supported LTS 8.4.x or 9.7.x image tag."
}

selected_database_version() {
  local database="$1"
  local version_key

  version_key="$(database_version_key "${database}")" || return 0
  env_get "${ENV_FILE}" "${version_key}"
}

validate_certificate_domain() {
  local domain="$1"

  [[ "${domain}" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*[A-Za-z0-9]$|^[A-Za-z0-9]$ ]] ||
    fail "Invalid certificate domain: ${domain}"
  [[ "${domain}" != *..* ]] || fail "Invalid certificate domain: ${domain}"
}

generate_self_signed_certificate() {
  local domain="$1"
  local certificate_dir
  local certificate_file
  local certificate_temporary
  local fingerprint
  local private_key_file
  local private_key_temporary

  validate_certificate_domain "${domain}"
  command -v openssl >/dev/null 2>&1 || fail "openssl is required."
  certificate_dir="$(data_dir)/certs/live/${domain}"
  certificate_file="${certificate_dir}/fullchain.pem"
  private_key_file="${certificate_dir}/privkey.pem"
  mkdir -p "${certificate_dir}"
  certificate_temporary="$(mktemp "${certificate_dir}/.fullchain.XXXXXX")"
  private_key_temporary="$(mktemp "${certificate_dir}/.privkey.XXXXXX")"
  trap 'rm -f "${certificate_temporary}" "${private_key_temporary}"' RETURN

  openssl req -x509 -nodes -newkey rsa:3072 -days 365 \
    -subj "/CN=${domain}" \
    -addext "subjectAltName=DNS:${domain}" \
    -keyout "${private_key_temporary}" \
    -out "${certificate_temporary}" >/dev/null 2>&1
  chmod 0644 "${certificate_temporary}"
  chmod 0600 "${private_key_temporary}"
  mv "${private_key_temporary}" "${private_key_file}"
  mv "${certificate_temporary}" "${certificate_file}"
  trap - RETURN

  fingerprint="$(
    openssl x509 -in "${certificate_file}" -noout -fingerprint -sha256 |
      sed 's/^[^=]*=//'
  )"
  log "Generated a self-signed certificate for ${domain}"
  log "Certificate: ${certificate_file}"
  log "Private key: ${private_key_file} (content is never printed)"
  log "SHA-256 fingerprint: ${fingerprint}"
}

set_feature_flag() {
  local feature="$1"
  local value="$2"

  case "${feature}" in
    redis) env_set "${ENV_FILE}" ENABLE_REDIS "${value}" ;;
    memcached) env_set "${ENV_FILE}" ENABLE_MEMCACHED "${value}" ;;
    cache)
      env_set "${ENV_FILE}" ENABLE_REDIS "${value}"
      env_set "${ENV_FILE}" ENABLE_MEMCACHED "${value}"
      ;;
    node) env_set "${ENV_FILE}" ENABLE_NODE "${value}" ;;
    tomcat) env_set "${ENV_FILE}" ENABLE_TOMCAT "${value}" ;;
    phpmyadmin) env_set "${ENV_FILE}" ENABLE_PHPMYADMIN "${value}" ;;
    adminer) env_set "${ENV_FILE}" ENABLE_ADMINER "${value}" ;;
    apisix) env_set "${ENV_FILE}" ENABLE_APISIX "${value}" ;;
    ftp) env_set "${ENV_FILE}" ENABLE_FTP "${value}" ;;
    *) fail "Unknown optional feature: ${feature}" ;;
  esac
}

apply_feature_list() {
  local list="$1"
  local value="$2"
  local feature
  local old_ifs="${IFS}"

  IFS=','
  for feature in ${list}; do
    [[ -n "${feature}" ]] || continue
    set_feature_flag "${feature}" "${value}"
  done
  IFS="${old_ifs}"
}

sync_profiles() {
  local web
  local database
  local profiles=""
  local additional_php
  local php_version
  local old_ifs="${IFS}"

  web="$(selected_web_service)"
  database="$(selected_database_service)"

  [[ "${web}" == "none" ]] || profiles="$(csv_add "${profiles}" "web-${web}")"
  [[ "${database}" == "none" ]] || profiles="$(csv_add "${profiles}" "db-${database}")"
  [[ "$(env_get "${ENV_FILE}" ENABLE_REDIS 0)" == "1" ]] &&
    profiles="$(csv_add "${profiles}" redis)"
  [[ "$(env_get "${ENV_FILE}" ENABLE_MEMCACHED 0)" == "1" ]] &&
    profiles="$(csv_add "${profiles}" memcached)"
  [[ "$(env_get "${ENV_FILE}" ENABLE_NODE 0)" == "1" ]] &&
    profiles="$(csv_add "${profiles}" runtime-node)"
  [[ "$(env_get "${ENV_FILE}" ENABLE_TOMCAT 0)" == "1" ]] &&
    profiles="$(csv_add "${profiles}" runtime-tomcat)"
  [[ "$(env_get "${ENV_FILE}" ENABLE_PHPMYADMIN 0)" == "1" ]] &&
    profiles="$(csv_add "${profiles}" tools-phpmyadmin)"
  [[ "$(env_get "${ENV_FILE}" ENABLE_ADMINER 0)" == "1" ]] &&
    profiles="$(csv_add "${profiles}" tools-adminer)"
  [[ "$(env_get "${ENV_FILE}" ENABLE_FTP 0)" == "1" ]] &&
    profiles="$(csv_add "${profiles}" ftp)"
  [[ "$(env_get "${ENV_FILE}" ENABLE_APISIX 0)" == "1" ]] &&
    profiles="$(csv_add "${profiles}" feature-apisix)"

  additional_php="$(env_get "${ENV_FILE}" ADDITIONAL_PHP)"
  IFS=','
  for php_version in ${additional_php}; do
    [[ -n "${php_version}" ]] || continue
    profiles="$(csv_add "${profiles}" "runtime-php${php_version/.}")"
  done
  IFS="${old_ifs}"

  env_set "${ENV_FILE}" COMPOSE_PROFILES "${profiles}"
}

configure_stack() {
  local original_env_file
  local temporary_env_file
  local web=""
  local database=""
  local database_spec=""
  local database_version=""
  local version_key=""
  local php_version=""
  local php_extensions=""
  local enable_features=""
  local disable_features=""
  local redis_version=""
  local memcached_version=""
  local tomcat_version=""
  local jdk_version=""
  local node_version=""
  local phpmyadmin_version=""
  local adminer_version=""
  local apisix_version=""
  local ftp_tls_mode=""
  local ftp_tls_domain=""
  local extra_pecl_packages=""
  local extra_pecl_packages_set=0
  local accept_microsoft_eula=0

  if (($# == 1)) && [[ "$1" =~ ^(-h|--help)$ ]]; then
    show_configure_help
    return 0
  fi

  require_env_file
  original_env_file="${ENV_FILE}"
  temporary_env_file="$(mktemp "$(dirname -- "${ENV_FILE}")/.oneinstack.configure.XXXXXX")"
  cp "${ENV_FILE}" "${temporary_env_file}"
  chmod 0600 "${temporary_env_file}"
  trap 'rm -f "${temporary_env_file}"' EXIT
  ENV_FILE="${temporary_env_file}"

  while (($# > 0)); do
    case "$1" in
      --web) web="${2:?--web requires a value}"; shift 2 ;;
      --db | --database) database_spec="${2:?--db requires ENGINE[:VERSION]}"; shift 2 ;;
      --php) php_version="${2:?--php requires a version}"; shift 2 ;;
      --extensions) php_extensions="${2:?--extensions requires a comma-separated list}"; shift 2 ;;
      --pecl-extra)
        extra_pecl_packages="${2:?--pecl-extra requires MODULE@PACKAGE-VERSION or none}"
        extra_pecl_packages_set=1
        shift 2
        ;;
      --accept-microsoft-eula) accept_microsoft_eula=1; shift ;;
      --enable) enable_features="${2:?--enable requires a comma-separated list}"; shift 2 ;;
      --disable) disable_features="${2:?--disable requires a comma-separated list}"; shift 2 ;;
      --redis) redis_version="${2:?--redis requires a version}"; shift 2 ;;
      --memcached) memcached_version="${2:?--memcached requires a version}"; shift 2 ;;
      --tomcat) tomcat_version="${2:?--tomcat requires a version}"; shift 2 ;;
      --jdk) jdk_version="${2:?--jdk requires a version}"; shift 2 ;;
      --phpmyadmin) phpmyadmin_version="${2:?--phpmyadmin requires a version}"; shift 2 ;;
      --adminer) adminer_version="${2:?--adminer requires a version}"; shift 2 ;;
      --apisix) apisix_version="${2:?--apisix requires a version}"; shift 2 ;;
      --ftp-tls-mode) ftp_tls_mode="${2:?--ftp-tls-mode requires a value}"; shift 2 ;;
      --ftp-tls-domain) ftp_tls_domain="${2:?--ftp-tls-domain requires a domain}"; shift 2 ;;
      --node) node_version="${2:?--node requires a version}"; shift 2 ;;
      *) fail "Unknown configure option: $1" ;;
    esac
  done

  if [[ -n "${web}" ]]; then
    [[ "${web}" =~ ^(nginx|tengine|openresty|caddy|apache|npm|none)$ ]] ||
      fail "Web engine must be nginx, tengine, openresty, caddy, apache, npm or none."
    env_set "${ENV_FILE}" WEB_ENGINE "${web}"
  fi

  if [[ -n "${database_spec}" ]]; then
    database="${database_spec%%:*}"
    if [[ "${database_spec}" == *:* ]]; then
      database_version="${database_spec#*:}"
      [[ -n "${database_version}" ]] ||
        fail "Database version must not be empty."
      validate_image_tag "${database_version}" "Database version"
    fi
    [[ "${database}" =~ ^(mysql|mariadb|percona|postgresql|mongodb|none)$ ]] ||
      fail "Database must be mysql, mariadb, percona, postgresql, mongodb or none."
    if [[ -n "${database_version}" ]]; then
      version_key="$(database_version_key "${database}")" ||
        fail "Database 'none' does not accept a version."
      [[ "${database}" != "mysql" ]] ||
        validate_mysql_lts_version "${database_version}"
      env_set "${ENV_FILE}" "${version_key}" "${database_version}"
    fi
    env_set "${ENV_FILE}" DATABASE_ENGINE "${database}"
    case "${database}" in
      mysql | mariadb | percona)
        env_set "${ENV_FILE}" DATABASE_HOST "${database}"
        env_set "${ENV_FILE}" DATABASE_PORT 3306
        ;;
      postgresql)
        env_set "${ENV_FILE}" DATABASE_HOST postgresql
        env_set "${ENV_FILE}" DATABASE_PORT 5432
        ;;
      mongodb)
        env_set "${ENV_FILE}" DATABASE_HOST mongodb
        env_set "${ENV_FILE}" DATABASE_PORT 27017
        ;;
      none)
        env_set "${ENV_FILE}" DATABASE_HOST ""
        env_set "${ENV_FILE}" DATABASE_PORT ""
        ;;
    esac
  fi

  if [[ -n "${php_version}" ]]; then
    validate_supported_php_version "${php_version}"
    env_set "${ENV_FILE}" PHP_VERSION "${php_version}"
    env_set "${ENV_FILE}" PHP_VARIANT fpm-bookworm
  fi

  if [[ -n "${php_extensions}" ]]; then
    [[ "${php_extensions}" =~ ^[a-z0-9_,-]+$ ]] ||
      fail "PHP extensions must be a comma-separated lowercase list."
    validate_php_extensions "${php_extensions}"
    env_set "${ENV_FILE}" PHP_EXTENSIONS "${php_extensions}"
  fi

  if ((extra_pecl_packages_set == 1)); then
    if [[ "${extra_pecl_packages}" == "none" ]]; then
      extra_pecl_packages=""
    else
      validate_extra_pecl_packages "${extra_pecl_packages}"
    fi
    env_set "${ENV_FILE}" PHP_EXTRA_PECL_PACKAGES "${extra_pecl_packages}"
  fi

  if ((accept_microsoft_eula == 1)); then
    env_set "${ENV_FILE}" MICROSOFT_ODBC_ACCEPT_EULA Y
  fi

  [[ -z "${enable_features}" ]] || apply_feature_list "${enable_features}" 1
  [[ -z "${disable_features}" ]] || apply_feature_list "${disable_features}" 0

  if [[ -n "${redis_version}" ]]; then
    validate_image_tag "${redis_version}" "Redis version"
    env_set "${ENV_FILE}" REDIS_VERSION "${redis_version}"
    env_set "${ENV_FILE}" ENABLE_REDIS 1
  fi

  if [[ -n "${memcached_version}" ]]; then
    validate_image_tag "${memcached_version}" "Memcached version"
    env_set "${ENV_FILE}" MEMCACHED_VERSION "${memcached_version}"
    env_set "${ENV_FILE}" ENABLE_MEMCACHED 1
  fi

  if [[ -n "${tomcat_version}" ]]; then
    [[ "${tomcat_version}" =~ ^(9\.0|10\.1|11\.0)$ ]] ||
      fail "Maintained Tomcat container lines are 9.0, 10.1 and 11.0."
    env_set "${ENV_FILE}" TOMCAT_VERSION "${tomcat_version}"
    env_set "${ENV_FILE}" ENABLE_TOMCAT 1
  fi

  if [[ -n "${jdk_version}" ]]; then
    [[ "${jdk_version}" =~ ^(8|11|17|21|25)$ ]] ||
      fail "JDK must be a maintained Temurin LTS: 8, 11, 17, 21 or 25."
    env_set "${ENV_FILE}" JDK_VERSION "${jdk_version}"
  fi

  if [[ -n "${phpmyadmin_version}" ]]; then
    validate_image_tag "${phpmyadmin_version}" "phpMyAdmin version"
    env_set "${ENV_FILE}" PHPMYADMIN_VERSION "${phpmyadmin_version}"
    env_set "${ENV_FILE}" ENABLE_PHPMYADMIN 1
  fi

  if [[ -n "${adminer_version}" ]]; then
    validate_image_tag "${adminer_version}" "Adminer version"
    env_set "${ENV_FILE}" ADMINER_VERSION "${adminer_version}"
    env_set "${ENV_FILE}" ENABLE_ADMINER 1
  fi

  if [[ -n "${apisix_version}" ]]; then
    validate_image_tag "${apisix_version}" "APISIX version"
    env_set "${ENV_FILE}" APISIX_VERSION "${apisix_version}"
    env_set "${ENV_FILE}" ENABLE_APISIX 1
  fi

  if [[ -n "${ftp_tls_mode}" ]]; then
    [[ "${ftp_tls_mode}" =~ ^(required|optional|off)$ ]] ||
      fail "FTP TLS mode must be required, optional or off."
    env_set "${ENV_FILE}" FTP_TLS_MODE "${ftp_tls_mode}"
  fi

  if [[ -n "${ftp_tls_domain}" ]]; then
    validate_certificate_domain "${ftp_tls_domain}"
    env_set "${ENV_FILE}" FTP_TLS_DOMAIN "${ftp_tls_domain}"
  fi

  if [[ -n "${node_version}" ]]; then
    [[ "${node_version}" =~ ^[0-9]+$ ]] || fail "Node.js version must be a major number."
    env_set "${ENV_FILE}" NODE_VERSION "${node_version}"
    env_set "${ENV_FILE}" ENABLE_NODE 1
  fi

  validate_runtime_selection
  sync_profiles
  mv "${temporary_env_file}" "${original_env_file}"
  ENV_FILE="${original_env_file}"
  trap - EXIT
  "${SCRIPT_DIR}/scripts/site.sh" "${ENV_FILE}" render-all
  show_selected_config
}

validate_php_extensions() {
  local extensions="$1"
  local extension
  local old_ifs="${IFS}"

  [[ "${extensions}" != "none" ]] || return 0

  IFS=','
  for extension in ${extensions}; do
    case "${extension}" in
      imagick | redis | memcached | memcache | mongodb | pgsql | ldap | calendar | imap | apcu | yaf | phalcon | yar | swoole | xdebug | sqlsrv | fileinfo | opcache)
        ;;
      *) fail "Unsupported PHP extension in the container builder: ${extension}" ;;
    esac
  done
  IFS="${old_ifs}"
}

validate_extra_pecl_packages() {
  local packages="$1"

  [[ "${packages}" =~ ^([a-z][a-z0-9_]*@[A-Za-z][A-Za-z0-9_]*-[0-9][A-Za-z0-9._-]*)(,[a-z][a-z0-9_]*@[A-Za-z][A-Za-z0-9_]*-[0-9][A-Za-z0-9._-]*)*$ ]] ||
    fail "Extra PECL packages must use MODULE@PACKAGE-VERSION entries."
}

validate_php_extension_selection() {
  local extensions
  local extra_packages
  local php_version
  local additional_php

  extensions="$(env_get "${ENV_FILE}" PHP_EXTENSIONS none)"
  extra_packages="$(env_get "${ENV_FILE}" PHP_EXTRA_PECL_PACKAGES)"
  php_version="$(env_get "${ENV_FILE}" PHP_VERSION)"
  additional_php="$(env_get "${ENV_FILE}" ADDITIONAL_PHP)"

  validate_php_extensions "${extensions}"
  [[ -z "${extra_packages}" ]] || validate_extra_pecl_packages "${extra_packages}"

  if csv_contains "${extensions}" sqlsrv; then
    [[ "$(env_get "${ENV_FILE}" MICROSOFT_ODBC_ACCEPT_EULA N)" == "Y" ]] ||
      fail "sqlsrv requires --accept-microsoft-eula."
    [[ "${php_version}" != "8.2" ]] ||
      fail "sqlsrv 5.13 requires PHP 8.3 or newer."
    ! csv_contains "${additional_php}" 8.2 ||
      fail "sqlsrv 5.13 cannot be built for an additional PHP 8.2 runtime."
  fi
}

manage_php_extensions() {
  local action="${1:-list}"
  local value="${2:-}"
  local service="${2:-php}"
  local extensions
  local result
  local extension
  local extra_pecl
  local old_ifs="${IFS}"

  require_env_file
  extensions="$(env_get "${ENV_FILE}" PHP_EXTENSIONS none)"
  extra_pecl="$(env_get "${ENV_FILE}" PHP_EXTRA_PECL_PACKAGES)"
  [[ -n "${extra_pecl}" ]] || extra_pecl="none"

  case "${action}" in
    list)
      printf '%s\n' \
        "Supported: calendar,fileinfo,imap,ldap,opcache,pgsql" \
        "PECL:     apcu,imagick,memcache,memcached,mongodb,phalcon,redis,swoole,xdebug,yaf,yar" \
        "Vendor:   sqlsrv (also installs pdo_sqlsrv; PHP 8.3+; EULA required)" \
        "Selected: ${extensions}" \
        "Extra:    ${extra_pecl}"
      ;;
    set)
      [[ -n "${value}" ]] || fail "Usage: php-ext set EXTENSION[,EXTENSION...]"
      configure_stack --extensions "${value}"
      ;;
    add)
      [[ -n "${value}" ]] || fail "Usage: php-ext add EXTENSION[,EXTENSION...]"
      result="${extensions}"
      [[ "${result}" != "none" ]] || result=""
      IFS=','
      for extension in ${value}; do
        result="$(csv_add "${result}" "${extension}")"
      done
      IFS="${old_ifs}"
      configure_stack --extensions "${result}"
      ;;
    remove | delete)
      [[ -n "${value}" ]] || fail "Usage: php-ext remove EXTENSION[,EXTENSION...]"
      result="${extensions}"
      [[ "${result}" != "none" ]] || result=""
      IFS=','
      for extension in ${value}; do
        result="$(csv_remove "${result}" "${extension}")"
      done
      IFS="${old_ifs}"
      configure_stack --extensions "${result:-none}"
      ;;
    verify)
      [[ "${service}" =~ ^php(82|83|84|85)?$ ]] ||
        fail "PHP service must be php, php82, php83, php84 or php85."
      validate_php_extension_selection
      run_compose exec -T "${service}" /usr/local/bin/oneinstack-install-php-extensions verify
      ;;
    *) fail "Usage: php-ext {list|set LIST|add LIST|remove LIST|verify [SERVICE]}" ;;
  esac
}

manage_php_runtime() {
  local action="${1:-list}"
  local version="${2:-}"
  local runtimes
  local main_version

  require_env_file
  runtimes="$(env_get "${ENV_FILE}" ADDITIONAL_PHP)"
  main_version="$(env_get "${ENV_FILE}" PHP_VERSION)"

  case "${action}" in
    add)
      validate_supported_php_version "${version}"
      [[ "${version}" != "${main_version}" ]] ||
        fail "PHP ${version} is already the primary runtime."
      if [[ "${version}" == "8.2" ]] &&
        csv_contains "$(env_get "${ENV_FILE}" PHP_EXTENSIONS none)" sqlsrv; then
        fail "sqlsrv 5.13 cannot be built for PHP 8.2."
      fi
      runtimes="$(csv_add "${runtimes}" "${version}")"
      env_set "${ENV_FILE}" ADDITIONAL_PHP "${runtimes}"
      sync_profiles
      ;;
    remove | delete)
      validate_supported_php_version "${version}"
      runtimes="$(csv_remove "${runtimes}" "${version}")"
      env_set "${ENV_FILE}" ADDITIONAL_PHP "${runtimes}"
      sync_profiles
      ;;
    list)
      printf 'Primary PHP:    %s (service php)\n' "${main_version}"
      printf 'Additional PHP: %s\n' "${runtimes:-none}"
      ;;
    *) fail "Usage: php-runtime {add VERSION|remove VERSION|list}" ;;
  esac
}

validate_runtime_selection() {
  local additional_php
  local php_runtime
  local tomcat_version
  local jdk_version
  local database
  local ftp_tls_mode
  local ftp_tls_domain

  tomcat_version="$(env_get "${ENV_FILE}" TOMCAT_VERSION 11.0)"
  jdk_version="$(env_get "${ENV_FILE}" JDK_VERSION 25)"
  database="$(selected_database_service)"
  validate_managed_data_dir
  validate_supported_php_version "$(env_get "${ENV_FILE}" PHP_VERSION)"
  additional_php="$(env_get "${ENV_FILE}" ADDITIONAL_PHP)"
  while IFS= read -r php_runtime; do
    [[ -n "${php_runtime}" ]] || continue
    validate_supported_php_version "${php_runtime}"
  done < <(tr ',' '\n' <<<"${additional_php}")
  validate_php_extension_selection
  [[ "${database}" != "mysql" ]] ||
    validate_mysql_lts_version "$(env_get "${ENV_FILE}" MYSQL_VERSION)"

  case "${tomcat_version}:${jdk_version}" in
    9.0:8 | 9.0:11 | 9.0:17 | 9.0:21 | 9.0:25 | \
      10.1:11 | 10.1:17 | 10.1:21 | 10.1:25 | \
      11.0:17 | 11.0:21 | 11.0:25)
      ;;
    *) fail "Temurin ${jdk_version} does not meet the Java requirement for Tomcat ${tomcat_version}." ;;
  esac

  ftp_tls_mode="$(env_get "${ENV_FILE}" FTP_TLS_MODE required)"
  ftp_tls_domain="$(env_get "${ENV_FILE}" FTP_TLS_DOMAIN)"
  [[ "${ftp_tls_mode}" =~ ^(required|optional|off)$ ]] ||
    fail "FTP_TLS_MODE must be required, optional or off."
  if [[ "$(env_get "${ENV_FILE}" ENABLE_FTP 0)" == "1" && "${ftp_tls_mode}" != "off" ]]; then
    [[ -n "${ftp_tls_domain}" ]] ||
      fail "FTPS requires FTP_TLS_DOMAIN. Use --ftp-tls-domain DOMAIN."
    validate_certificate_domain "${ftp_tls_domain}"
  fi

  if [[ "$(env_get "${ENV_FILE}" ENABLE_PHPMYADMIN 0)" == "1" ]] &&
    [[ ! "${database}" =~ ^(mysql|mariadb|percona)$ ]]; then
    fail "phpMyAdmin requires MySQL, MariaDB or Percona. Use Adminer for PostgreSQL."
  fi
  if [[ "$(env_get "${ENV_FILE}" ENABLE_ADMINER 0)" == "1" ]] &&
    [[ ! "${database}" =~ ^(mysql|mariadb|percona|postgresql)$ ]]; then
    fail "Adminer requires a relational database."
  fi
}

require_full_stack_artifacts() {
  local certificate_dir
  local ftp_tls_domain
  local ftp_tls_mode

  [[ "$(env_get "${ENV_FILE}" ENABLE_FTP 0)" == "1" ]] || return 0
  ftp_tls_mode="$(env_get "${ENV_FILE}" FTP_TLS_MODE required)"
  [[ "${ftp_tls_mode}" != "off" ]] || return 0
  ftp_tls_domain="$(env_get "${ENV_FILE}" FTP_TLS_DOMAIN)"
  certificate_dir="$(data_dir)/certs/live/${ftp_tls_domain}"
  if [[ ! -r "${certificate_dir}/fullchain.pem" ||
    ! -r "${certificate_dir}/privkey.pem" ]]; then
    generate_self_signed_certificate "${ftp_tls_domain}"
  fi
}

wait_for_service_health() {
  local service="$1"
  local timeout
  local deadline
  local container_id
  local state

  timeout="$(env_get "${ENV_FILE}" STARTUP_HEALTH_TIMEOUT 180)"
  [[ "${timeout}" =~ ^[1-9][0-9]*$ ]] ||
    fail "STARTUP_HEALTH_TIMEOUT must be a positive integer."
  deadline=$((SECONDS + timeout))

  while ((SECONDS < deadline)); do
    container_id="$(run_compose ps --quiet "${service}" 2>/dev/null || true)"
    if [[ -n "${container_id}" ]]; then
      state="$(docker inspect \
        --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' \
        "${container_id}" 2>/dev/null || true)"
      case "${state}" in
        healthy | running)
          log "${service}: ${state}"
          return 0
          ;;
        unhealthy | exited | dead)
          run_compose logs --tail=80 "${service}" >&2 || true
          fail "${service} entered state: ${state}"
          ;;
      esac
    fi
    sleep 2
  done

  run_compose logs --tail=80 "${service}" >&2 || true
  fail "Timed out waiting for ${service} health after ${timeout}s."
}

selected_stack_services() {
  local additional_php
  local database
  local php_version
  local web
  local old_ifs="${IFS}"

  printf '%s\n' php
  web="$(selected_web_service)"
  database="$(selected_database_service)"
  [[ "${web}" == "none" ]] || printf '%s\n' "${web}"
  [[ "${database}" == "none" ]] || printf '%s\n' "${database}"
  [[ "$(env_get "${ENV_FILE}" ENABLE_REDIS 0)" == "1" ]] && printf '%s\n' redis
  [[ "$(env_get "${ENV_FILE}" ENABLE_MEMCACHED 0)" == "1" ]] && printf '%s\n' memcached
  [[ "$(env_get "${ENV_FILE}" ENABLE_NODE 0)" == "1" ]] && printf '%s\n' node
  [[ "$(env_get "${ENV_FILE}" ENABLE_TOMCAT 0)" == "1" ]] && printf '%s\n' tomcat
  [[ "$(env_get "${ENV_FILE}" ENABLE_PHPMYADMIN 0)" == "1" ]] && printf '%s\n' phpmyadmin
  [[ "$(env_get "${ENV_FILE}" ENABLE_ADMINER 0)" == "1" ]] && printf '%s\n' adminer
  [[ "$(env_get "${ENV_FILE}" ENABLE_FTP 0)" == "1" ]] && printf '%s\n' ftp
  if [[ "$(env_get "${ENV_FILE}" ENABLE_APISIX 0)" == "1" ]]; then
    printf '%s\n' apisix-etcd apisix
  fi

  additional_php="$(env_get "${ENV_FILE}" ADDITIONAL_PHP)"
  IFS=','
  for php_version in ${additional_php}; do
    [[ -n "${php_version}" ]] || continue
    printf 'php%s\n' "${php_version/.}"
  done
  IFS="${old_ifs}"
}

wait_for_selected_stack() {
  local service

  while IFS= read -r service; do
    [[ -n "${service}" ]] || continue
    wait_for_service_health "${service}"
  done < <(selected_stack_services)
}

start_selected_dependencies() {
  local build_mode="$1"
  local database
  local -a dependencies=()
  local service

  database="$(selected_database_service)"
  [[ "${database}" == "none" ]] || dependencies+=("${database}")
  [[ "$(env_get "${ENV_FILE}" ENABLE_REDIS 0)" == "1" ]] &&
    dependencies+=(redis)
  [[ "$(env_get "${ENV_FILE}" ENABLE_MEMCACHED 0)" == "1" ]] &&
    dependencies+=(memcached)

  ((${#dependencies[@]} > 0)) || return 0
  if [[ "${build_mode}" == "build" ]]; then
    run_compose up --detach --build "${dependencies[@]}"
  else
    run_compose up --detach "${dependencies[@]}"
  fi
  for service in "${dependencies[@]}"; do
    wait_for_service_health "${service}"
  done
}

show_selected_config() {
  local additional_php
  local database
  local database_label
  local database_version
  local extra_pecl

  require_env_file
  additional_php="$(env_get "${ENV_FILE}" ADDITIONAL_PHP)"
  [[ -n "${additional_php}" ]] || additional_php="none"
  database="$(selected_database_service)"
  database_version="$(selected_database_version "${database}")"
  database_label="${database}"
  [[ -z "${database_version}" ]] ||
    database_label="${database}:${database_version}"
  extra_pecl="$(env_get "${ENV_FILE}" PHP_EXTRA_PECL_PACKAGES)"
  [[ -n "${extra_pecl}" ]] || extra_pecl="none"

  printf 'Web:              %s\n' "$(selected_web_service)"
  printf 'Database:         %s (%s:%s)\n' \
    "${database_label}" \
    "$(env_get "${ENV_FILE}" DATABASE_HOST -)" \
    "$(env_get "${ENV_FILE}" DATABASE_PORT -)"
  printf 'PHP:              %s [%s]\n' \
    "$(env_get "${ENV_FILE}" PHP_VERSION)" \
    "$(env_get "${ENV_FILE}" PHP_EXTENSIONS)"
  printf 'Extra PECL:       %s\n' "${extra_pecl}"
  printf 'Tomcat/JDK:       %s / Temurin %s (enabled=%s)\n' \
    "$(env_get "${ENV_FILE}" TOMCAT_VERSION)" \
    "$(env_get "${ENV_FILE}" JDK_VERSION)" \
    "$(env_get "${ENV_FILE}" ENABLE_TOMCAT 0)"
  printf 'Node.js:          %s (enabled=%s)\n' \
    "$(env_get "${ENV_FILE}" NODE_VERSION)" \
    "$(env_get "${ENV_FILE}" ENABLE_NODE 0)"
  printf 'Additional PHP:   %s\n' "${additional_php}"
  printf 'Redis/Memcached:  %s / %s\n' \
    "$(env_get "${ENV_FILE}" ENABLE_REDIS 0)" \
    "$(env_get "${ENV_FILE}" ENABLE_MEMCACHED 0)"
  printf 'FTP/TLS:          %s / %s (%s)\n' \
    "$(env_get "${ENV_FILE}" ENABLE_FTP 0)" \
    "$(env_get "${ENV_FILE}" FTP_TLS_MODE required)" \
    "$(env_get "${ENV_FILE}" FTP_TLS_DOMAIN -)"
  printf 'APISIX:           %s (version=%s, admin=%s:%s)\n' \
    "$(env_get "${ENV_FILE}" ENABLE_APISIX 0)" \
    "$(env_get "${ENV_FILE}" APISIX_VERSION)" \
    "$(env_get "${ENV_FILE}" APISIX_ADMIN_BIND 127.0.0.1)" \
    "$(env_get "${ENV_FILE}" APISIX_ADMIN_PORT 9180)"
  printf 'Host data:        %s\n' "$(data_dir)"
  printf 'Networks:         frontend + shared backend + runtime egress\n'
  printf 'Profiles:         %s\n' "$(env_get "${ENV_FILE}" COMPOSE_PROFILES)"
  printf 'Secret sources:\n'
  manage_secrets list
}

reload_web() {
  local web
  web="$(selected_web_service)"

  case "${web}" in
    nginx)
      # shellcheck disable=SC2016
      run_compose exec nginx sh -c 'nginx -t && nginx -s reload'
      ;;
    tengine)
      run_compose exec tengine sh -c \
        '/usr/local/tengine/sbin/nginx -t && /usr/local/tengine/sbin/nginx -s reload'
      ;;
    openresty)
      run_compose exec openresty sh -c 'openresty -t && openresty -s reload'
      ;;
    caddy)
      run_compose exec caddy caddy reload --config /etc/caddy/Caddyfile
      ;;
    apache)
      run_compose exec apache sh -c 'httpd -t && httpd -k graceful'
      ;;
    npm)
      run_compose restart npm
      ;;
    none) fail "No web server is selected." ;;
  esac
}

reload_web_if_running() {
  local web
  local container_id

  command -v docker >/dev/null 2>&1 || return 0
  docker info >/dev/null 2>&1 || return 0
  web="$(selected_web_service)"
  [[ "${web}" != "none" ]] || return 0

  container_id="$(run_compose ps --quiet "${web}" 2>/dev/null || true)"
  [[ -n "${container_id}" ]] || return 0
  [[ "$(docker inspect --format '{{.State.Running}}' "${container_id}" 2>/dev/null || true)" == "true" ]] ||
    return 0
  reload_web
}

restart_ftp_if_running() {
  local container_id

  [[ "$(env_get "${ENV_FILE}" ENABLE_FTP 0)" == "1" ]] || return 0
  command -v docker >/dev/null 2>&1 || return 0
  docker info >/dev/null 2>&1 || return 0

  container_id="$(run_compose ps --quiet ftp 2>/dev/null || true)"
  [[ -n "${container_id}" ]] || return 0
  [[ "$(docker inspect --format '{{.State.Running}}' "${container_id}" 2>/dev/null || true)" == "true" ]] ||
    return 0
  run_compose restart ftp
}

render_site_if_present() {
  local domain="$1"

  if [[ -f "$(data_dir)/sites/${domain}.env" ]]; then
    "${SCRIPT_DIR}/scripts/site.sh" "${ENV_FILE}" render "${domain}"
  fi
}

database_console() {
  local database
  database="$(selected_database_service)"

  case "${database}" in
    mysql | percona)
      # shellcheck disable=SC2016
      run_compose exec "${database}" sh -c \
        'MYSQL_PWD="$(cat "$MYSQL_PASSWORD_FILE")" exec mysql -u"$MYSQL_USER" "$MYSQL_DATABASE"'
      ;;
    mariadb)
      # shellcheck disable=SC2016
      run_compose exec mariadb sh -c \
        'MARIADB_PWD="$(cat "$MARIADB_PASSWORD_FILE")" exec mariadb -u"$MARIADB_USER" "$MARIADB_DATABASE"'
      ;;
    postgresql)
      # shellcheck disable=SC2016
      run_compose exec postgresql sh -c \
        'PGPASSWORD="$(cat "$POSTGRES_PASSWORD_FILE")" exec psql -U "$POSTGRES_USER" -d "$POSTGRES_DB"'
      ;;
    mongodb)
      # shellcheck disable=SC2016
      run_compose exec mongodb sh -c \
        'exec mongosh --username "$MONGO_INITDB_ROOT_USERNAME" --password "$(cat "$MONGO_INITDB_ROOT_PASSWORD_FILE")" --authenticationDatabase admin "$MONGO_INITDB_DATABASE"'
      ;;
    none) fail "No primary database is selected." ;;
  esac
}

manage_tls() {
  local action="${1:-}"
  local domain="${2:-}"
  local email="${3:-}"

  validate_managed_data_dir
  case "${action}" in
    self-signed)
      [[ -n "${domain}" ]] || fail "Usage: tls self-signed DOMAIN"
      generate_self_signed_certificate "${domain}"
      render_site_if_present "${domain}"
      reload_web_if_running
      restart_ftp_if_running
      ;;
    issue)
      [[ -n "${domain}" && -n "${email}" ]] ||
        fail "Usage: tls issue DOMAIN EMAIL"
      [[ "$(selected_web_service)" != "caddy" ]] ||
        fail "Caddy manages ACME certificates automatically; add the site with TLS mode auto."
      [[ "$(selected_web_service)" != "npm" ]] ||
        fail "Nginx Proxy Manager manages certificates through its admin UI."
      render_site_if_present "${domain}"
      run_compose run --rm certbot certonly \
        --webroot \
        --webroot-path /var/www/acme \
        --non-interactive \
        --agree-tos \
        --email "${email}" \
        --domain "${domain}"
      render_site_if_present "${domain}"
      reload_web_if_running
      restart_ftp_if_running
      ;;
    renew)
      [[ "$(selected_web_service)" != "npm" ]] ||
        fail "Nginx Proxy Manager renews certificates through its admin UI."
      run_compose run --rm certbot renew
      "${SCRIPT_DIR}/scripts/site.sh" "${ENV_FILE}" render-all
      reload_web_if_running
      restart_ftp_if_running
      ;;
    timer-install)
      [[ "$(selected_web_service)" != "npm" ]] ||
        fail "Nginx Proxy Manager renews certificates through its admin UI."
      "${SCRIPT_DIR}/scripts/cert-renew-timer.sh" \
        "${action#timer-}" "${SCRIPT_DIR}/oneinstack" "${ENV_FILE}"
      ;;
    timer-status | timer-remove)
      "${SCRIPT_DIR}/scripts/cert-renew-timer.sh" \
        "${action#timer-}" "${SCRIPT_DIR}/oneinstack" "${ENV_FILE}"
      ;;
    *)
      fail "Usage: tls {self-signed DOMAIN|issue DOMAIN EMAIL|renew|timer-install|timer-status|timer-remove}"
      ;;
  esac
}

purge_managed_data() {
  local directory
  local marker

  directory="$(data_dir)"
  marker="${directory}/.oneinstack-managed"
  [[ -f "${marker}" ]] ||
    fail "Refusing purge because the managed data marker is missing: ${marker}"
  [[ "$(head -n 1 "${marker}")" == "oneinstack-data-v1" ]] ||
    fail "Refusing purge because the managed data marker is invalid."

  rm -rf -- \
    "${directory}/caddy/config" \
    "${directory}/caddy/data" \
    "${directory}/apisix/etcd" \
    "${directory}/ftp" \
    "${directory}/mariadb" \
    "${directory}/mongodb" \
    "${directory}/mysql" \
    "${directory}/npm" \
    "${directory}/percona" \
    "${directory}/postgresql" \
    "${directory}/redis"
  mkdir -p \
    "${directory}/caddy/config" \
    "${directory}/caddy/data" \
    "${directory}/apisix/etcd" \
    "${directory}/ftp" \
    "${directory}/mariadb" \
    "${directory}/mongodb" \
    "${directory}/mysql" \
    "${directory}/npm/data" \
    "${directory}/npm/letsencrypt" \
    "${directory}/percona" \
    "${directory}/postgresql" \
    "${directory}/redis"
  chmod 0700 "${directory}/apisix/etcd"
  log "Purged managed database, cache, Caddy, NPM, APISIX and FTP data under ${directory}"
  log "Website, certificates, configuration, logs and backups were preserved."
}

while (($# > 0)); do
  case "$1" in
    --env-file)
      (($# >= 2)) || fail "--env-file requires a path."
      ENV_FILE="$(absolute_path "$2")"
      shift 2
      ;;
    --profile)
      (($# >= 2)) || fail "--profile requires a name."
      PROFILES+=("$2")
      shift 2
      ;;
    -h | --help)
      show_help
      exit 0
      ;;
    -v | --version)
      printf '%s %s\n' "${PROGRAM_NAME}" "${PROGRAM_VERSION}"
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      fail "Unknown global option: $1"
      ;;
    *)
      break
      ;;
  esac
done

subcommand="${1:-help}"
if (($# > 0)); then
  shift
fi

case "${subcommand}" in
  help)
    case "${1:-}" in
      "") show_help ;;
      configure) show_configure_help ;;
      *) fail "Unknown help topic: $1" ;;
    esac
    ;;
  init)
    initialize "$@"
    ;;
  configure)
    configure_stack "$@"
    ;;
  show-config)
    (($# == 0)) || fail "show-config does not accept arguments."
    show_selected_config
    ;;
  doctor)
    (($# == 0)) || fail "doctor does not accept arguments."
    doctor
    ;;
  config)
    require_env_file
    validate_runtime_selection
    run_compose config "$@"
    ;;
  build)
    require_env_file
    validate_runtime_selection
    run_compose build --pull "$@"
    ;;
  up)
    require_env_file
    validate_runtime_selection
    if (($# == 0)); then
      require_full_stack_artifacts
      start_selected_dependencies build
    fi
    run_compose up --detach --build "$@"
    if (($# == 0)); then
      wait_for_selected_stack
    fi
    ;;
  start | stop | restart)
    require_env_file
    run_compose "${subcommand}" "$@"
    ;;
  down)
    require_env_file
    run_compose down "$@"
    ;;
  update)
    require_env_file
    validate_runtime_selection
    if (($# == 0)); then
      require_full_stack_artifacts
    fi
    run_compose build --pull "$@"
    if (($# == 0)); then
      start_selected_dependencies no-build
    fi
    run_compose up --detach "$@"
    if (($# == 0)); then
      wait_for_selected_stack
    fi
    ;;
  ps | images)
    require_env_file
    run_compose "${subcommand}" "$@"
    ;;
  logs)
    require_env_file
    run_compose logs --follow --tail=200 "$@"
    ;;
  exec)
    require_env_file
    (($# >= 2)) || fail "Usage: ./oneinstack exec SERVICE COMMAND [ARGUMENT...]"
    run_compose exec "$@"
    ;;
  shell)
    require_env_file
    service="${1:-php}"
    run_compose exec "${service}" sh
    ;;
  db)
    require_env_file
    database_console
    ;;
  mysql)
    require_env_file
    [[ "$(selected_database_service)" =~ ^(mysql|mariadb|percona)$ ]] ||
      fail "The selected database is not MySQL-compatible. Use './oneinstack db'."
    database_console
    ;;
  redis-cli)
    require_env_file
    # Values are intentionally expanded by the shell inside the container.
    # shellcheck disable=SC2016
    run_compose exec redis sh -c \
      'REDISCLI_AUTH="$(cat "$REDIS_PASSWORD_FILE")" exec redis-cli'
    ;;
  php)
    require_env_file
    (($# > 0)) || fail "php requires PHP CLI arguments."
    run_compose exec php php "$@"
    ;;
  php-ext)
    manage_php_extensions "$@"
    ;;
  php-runtime)
    manage_php_runtime "$@"
    ;;
  composer)
    require_env_file
    run_compose exec php composer "$@"
    ;;
  node)
    require_env_file
    (($# > 0)) || fail "node requires a command."
    run_compose exec node "$@"
    ;;
  site)
    require_env_file
    "${SCRIPT_DIR}/scripts/site.sh" "${ENV_FILE}" "$@"
    case "${1:-list}" in
      add | delete | del | render | render-all) reload_web_if_running ;;
    esac
    ;;
  tls)
    require_env_file
    manage_tls "$@"
    ;;
  secret)
    [[ -f "${ENV_FILE}" ]] ||
      fail "Environment file not found: ${ENV_FILE}. Run './oneinstack init' first."
    validate_managed_data_dir
    manage_secrets "$@"
    ;;
  backup)
    require_env_file
    "${SCRIPT_DIR}/scripts/backup.sh" "${ENV_FILE}" "$@"
    ;;
  ftp-user)
    require_env_file
    run_compose exec ftp ftp-user "$@"
    ;;
  reload)
    require_env_file
    (($# == 0)) || fail "reload does not accept arguments."
    reload_web
    ;;
  purge)
    require_env_file
    if [[ "${1:-}" == "--yes" && $# == 1 ]]; then
      run_compose down --remove-orphans --rmi local
      log "All host data was preserved under $(data_dir)"
    elif [[ "${1:-}" == "--data" && "${2:-}" == "--yes" && $# == 2 ]]; then
      run_compose down --remove-orphans --rmi local
      purge_managed_data
    else
      fail "Usage: purge --yes | purge --data --yes"
    fi
    ;;
  compose)
    require_env_file
    (($# > 0)) || fail "compose requires Docker Compose arguments."
    run_compose "$@"
    ;;
  *)
    fail "Unknown command: ${subcommand}. Run './oneinstack help' for usage."
    ;;
esac
