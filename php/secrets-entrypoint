#!/bin/sh
set -eu

load_secret() {
  variable_name="$1"
  file_variable_name="${variable_name}_FILE"
  eval "current_value=\${${variable_name}:-}"
  eval "secret_file=\${${file_variable_name}:-}"

  if [ -z "${current_value}" ] && [ -n "${secret_file}" ]; then
    [ -r "${secret_file}" ] || {
      printf 'Secret file is not readable: %s\n' "${secret_file}" >&2
      exit 1
    }
    export "${variable_name}=$(cat "${secret_file}")"
  fi
}

load_secret DATABASE_PASSWORD
load_secret MYSQL_PASSWORD
load_secret REDIS_PASSWORD

exec docker-php-entrypoint "$@"
