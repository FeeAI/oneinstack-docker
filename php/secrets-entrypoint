#!/bin/sh
set -eu

load_secret() {
  variable_name="$1"
  file_variable_name="${variable_name}_FILE"
  eval "current_value=\${${variable_name}:-}"
  eval "secret_file=\${${file_variable_name}:-}"

  if [ -z "${current_value}" ] && [ -n "${secret_file}" ]; then
    [ -r "${secret_file}" ] || {
      printf 'Secret file is not readable: %s\n' "${secret_file}" >&2
      exit 1
    }
    export "${variable_name}=$(cat "${secret_file}")"
  fi
}

set_default() {
  variable_name="$1"
  default_value="$2"
  eval "current_value=\${${variable_name}:-}"
  if [ -z "${current_value}" ]; then
    current_value="${default_value}"
    export "${variable_name}=${current_value}"
  fi
}

validate_positive_integer() {
  variable_name="$1"
  validated_value=""
  eval "validated_value=\${${variable_name}}"
  case "${validated_value}" in
    '' | *[!0-9]* | 0)
      printf '%s must be a positive integer: %s\n' \
        "${variable_name}" "${validated_value}" >&2
      exit 1
      ;;
  esac
}

validate_php_size() {
  variable_name="$1"
  validated_value=""
  eval "validated_value=\${${variable_name}}"
  printf '%s\n' "${validated_value}" | grep -Eq '^[1-9][0-9]*[KMG]$' || {
    printf '%s must use a positive PHP size such as 256M: %s\n' \
      "${variable_name}" "${validated_value}" >&2
    exit 1
  }
}

validate_duration() {
  variable_name="$1"
  validated_value=""
  eval "validated_value=\${${variable_name}}"
  printf '%s\n' "${validated_value}" | grep -Eq '^(0|[1-9][0-9]*[smhd]?)$' || {
    printf '%s must be 0 or a positive duration with an optional s, m, h or d suffix: %s\n' \
      "${variable_name}" "${validated_value}" >&2
    exit 1
  }
}

configure_php_runtime() {
  set_default PHP_MEMORY_LIMIT 256M
  set_default PHP_MAX_EXECUTION_TIME 300
  set_default PHP_MAX_INPUT_TIME 300
  set_default PHP_POST_MAX_SIZE 256M
  set_default PHP_UPLOAD_MAX_FILESIZE 256M
  set_default PHP_REALPATH_CACHE_SIZE 4M
  set_default PHP_REALPATH_CACHE_TTL 120
  set_default PHP_OPCACHE_MEMORY_CONSUMPTION 192
  set_default PHP_OPCACHE_MAX_ACCELERATED_FILES 100000
  set_default PHP_OPCACHE_REVALIDATE_FREQ 2
  set_default PHP_FPM_MAX_CHILDREN 3
  set_default PHP_FPM_START_SERVERS 2
  set_default PHP_FPM_MIN_SPARE_SERVERS 1
  set_default PHP_FPM_MAX_SPARE_SERVERS 2
  set_default PHP_FPM_MAX_REQUESTS 1000
  set_default PHP_FPM_REQUEST_TERMINATE_TIMEOUT 300s
  set_default PHP_FPM_REQUEST_SLOWLOG_TIMEOUT 10s

  for variable_name in \
    PHP_MEMORY_LIMIT PHP_POST_MAX_SIZE PHP_UPLOAD_MAX_FILESIZE \
    PHP_REALPATH_CACHE_SIZE; do
    validate_php_size "${variable_name}"
  done
  for variable_name in \
    PHP_MAX_EXECUTION_TIME PHP_MAX_INPUT_TIME PHP_REALPATH_CACHE_TTL \
    PHP_OPCACHE_MEMORY_CONSUMPTION PHP_OPCACHE_MAX_ACCELERATED_FILES \
    PHP_OPCACHE_REVALIDATE_FREQ PHP_FPM_MAX_CHILDREN \
    PHP_FPM_START_SERVERS PHP_FPM_MIN_SPARE_SERVERS \
    PHP_FPM_MAX_SPARE_SERVERS PHP_FPM_MAX_REQUESTS; do
    validate_positive_integer "${variable_name}"
  done
  validate_duration PHP_FPM_REQUEST_TERMINATE_TIMEOUT
  validate_duration PHP_FPM_REQUEST_SLOWLOG_TIMEOUT

  if [ "${PHP_FPM_START_SERVERS}" -gt "${PHP_FPM_MAX_CHILDREN}" ] || \
    [ "${PHP_FPM_MIN_SPARE_SERVERS}" -gt "${PHP_FPM_MAX_SPARE_SERVERS}" ] || \
    [ "${PHP_FPM_MAX_SPARE_SERVERS}" -gt "${PHP_FPM_MAX_CHILDREN}" ]; then
    printf 'PHP-FPM worker settings are inconsistent with PHP_FPM_MAX_CHILDREN.\n' >&2
    exit 1
  fi

  template="${PHP_FPM_CONFIG_TEMPLATE:-/usr/local/etc/php-fpm.d/zz-oneinstack.conf.template}"
  target="${PHP_FPM_CONFIG_TARGET:-/usr/local/etc/php-fpm.d/zz-oneinstack.conf}"
  [ -r "${template}" ] || {
    printf 'PHP-FPM configuration template is not readable: %s\n' "${template}" >&2
    exit 1
  }
  temporary="${target}.tmp"
  sed \
    -e "s/^pm.max_children = .*/pm.max_children = ${PHP_FPM_MAX_CHILDREN}/" \
    -e "s/^pm.start_servers = .*/pm.start_servers = ${PHP_FPM_START_SERVERS}/" \
    -e "s/^pm.min_spare_servers = .*/pm.min_spare_servers = ${PHP_FPM_MIN_SPARE_SERVERS}/" \
    -e "s/^pm.max_spare_servers = .*/pm.max_spare_servers = ${PHP_FPM_MAX_SPARE_SERVERS}/" \
    -e "s/^pm.max_requests = .*/pm.max_requests = ${PHP_FPM_MAX_REQUESTS}/" \
    -e "s/^request_terminate_timeout = .*/request_terminate_timeout = ${PHP_FPM_REQUEST_TERMINATE_TIMEOUT}/" \
    -e "s/^request_slowlog_timeout = .*/request_slowlog_timeout = ${PHP_FPM_REQUEST_SLOWLOG_TIMEOUT}/" \
    "${template}" >"${temporary}"
  mv "${temporary}" "${target}"
  php-fpm --test
}

load_secret DATABASE_PASSWORD
load_secret MYSQL_PASSWORD
load_secret REDIS_PASSWORD
configure_php_runtime

exec docker-php-entrypoint "$@"
