#!/bin/sh
set -eu

if [ -z "${DATABASE_PASSWORD:-}" ] && [ -n "${DATABASE_PASSWORD_FILE:-}" ]; then
  [ -r "${DATABASE_PASSWORD_FILE}" ] || {
    printf 'Secret file is not readable: %s\n' "${DATABASE_PASSWORD_FILE}" >&2
    exit 1
  }
  DATABASE_PASSWORD="$(cat "${DATABASE_PASSWORD_FILE}")"
  export DATABASE_PASSWORD
fi

exec "$@"
