# Compose project and selected stack
COMPOSE_PROJECT_NAME=oneinstack
COMPOSE_PROFILES=web-nginx,db-mysql
WEB_ENGINE=nginx
DATABASE_ENGINE=mysql
TZ=Asia/Singapore
# init writes the absolute docker/data path, or the path supplied with --data-dir.
ONEINSTACK_DATA_DIR=

# Host user mapping used by writable application mounts
APP_UID=1000
APP_GID=1000

# Container resource and local json-file log limits
CONTAINER_LOG_MAX_SIZE=20m
CONTAINER_LOG_MAX_FILES=5
WEB_MEMORY_LIMIT=512m
WEB_CPUS=1.0
WEB_PIDS_LIMIT=256
PHP_CONTAINER_MEMORY_LIMIT=1g
PHP_CPUS=2.0
PHP_PIDS_LIMIT=512
DATABASE_MEMORY_LIMIT=2g
DATABASE_CPUS=2.0
DATABASE_PIDS_LIMIT=512
RUNTIME_MEMORY_LIMIT=1g
RUNTIME_CPUS=2.0
RUNTIME_PIDS_LIMIT=512
AUXILIARY_MEMORY_LIMIT=512m
AUXILIARY_CPUS=1.0
AUXILIARY_PIDS_LIMIT=256
STARTUP_HEALTH_TIMEOUT=180

# Published web ports
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_BIND=0.0.0.0
HTTPS_PORT=443

# Web server versions
NGINX_VERSION=stable
TENGINE_VERSION=3.1.0
TENGINE_SHA256=64ed7155c0c904ce0fe7199c21b8eb6c2abfc267278fa8af832c0cb781e864dc
OPENRESTY_VERSION=1.27.1.2-0-alpine
CADDY_VERSION=2
APACHE_VERSION=2.4

# PHP runtime. Supported by the maintained container builder: 8.2 through 8.5.
PHP_VERSION=8.4
PHP_VARIANT=fpm-bookworm
PHP_EXTENSIONS=imagick,redis,memcached,mongodb,pgsql
PHP_EXTRA_PECL_PACKAGES=
ADDITIONAL_PHP=
PHPREDIS_VERSION=6.3.0
PHP_MEMCACHED_VERSION=3.4.0
PHP_MEMCACHE_VERSION=8.2
PHP_MONGODB_VERSION=2.3.3
PHP_IMAGICK_VERSION=3.8.1
PHP_IMAP_VERSION=1.0.3
PHP_APCU_VERSION=5.1.28
PHP_YAF_VERSION=3.3.7
PHP_PHALCON_VERSION=5.17.0
PHP_MSGPACK_VERSION=3.0.1
PHP_YAR_VERSION=2.3.4
PHP_SWOOLE_VERSION=6.2.2
PHP_XDEBUG_VERSION=3.5.3
PHP_SQLSRV_VERSION=5.13.1
MICROSOFT_ODBC_ACCEPT_EULA=N

# Primary database selection and application credentials
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_NAME=oneinstack
DATABASE_USER=oneinstack
DATABASE_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Absolute host files used as Compose secret sources; init fills these paths.
DATABASE_PASSWORD_FILE=
MYSQL_ROOT_PASSWORD_FILE=
MONGODB_ROOT_USER=root
MONGODB_ROOT_PASSWORD=
MONGODB_ROOT_PASSWORD_FILE=

# Database image versions
MYSQL_VERSION=8.4
MARIADB_VERSION=10.11
PERCONA_VERSION=8.4
POSTGRES_VERSION=18
MONGODB_VERSION=8.0

# Cache services
REDIS_VERSION=8.8
REDIS_PASSWORD=
REDIS_PASSWORD_FILE=
MEMCACHED_VERSION=1.6
MEMCACHED_MEMORY_MB=128
MEMCACHED_MAX_CONNECTIONS=1024
MEMCACHED_THREADS=4

# Java and Node.js runtimes
TOMCAT_VERSION=11.0
JDK_VERSION=21
JDK_VENDOR=temurin
TOMCAT_DOCKERFILE=Dockerfile
ORACLE_JDK8_ARCHIVE=jdk-8u202-linux-x64.tar.gz
ORACLE_JDK8_SHA256=
ORACLE_JDK8_ACCEPT_BCL=N
CATALINA_OPTS=-Xms256m -Xmx512m
NODE_VERSION=22
NODE_ENV=production
NODE_PORT=3000
NODE_COMMAND=sleep infinity
ENABLE_NODE=0
ENABLE_TOMCAT=0

# Database management tools
PHPMYADMIN_VERSION=5-apache
PHPMYADMIN_BIND=127.0.0.1
PHPMYADMIN_PORT=8080
PHPMYADMIN_UPLOAD_LIMIT=256M
ADMINER_BIND=127.0.0.1
ADMINER_PORT=8081
ENABLE_REDIS=0
ENABLE_MEMCACHED=0
ENABLE_PHPMYADMIN=0
ENABLE_ADMINER=0

# Pure-FTPd virtual users
ENABLE_FTP=0
FTP_BIND=0.0.0.0
FTP_PORT=21
FTP_PUBLIC_HOST=
FTP_PASSIVE_START=30000
FTP_PASSIVE_END=30009
FTP_MAX_CLIENTS=50
FTP_MAX_CLIENTS_PER_IP=5
FTP_TLS_MODE=required
FTP_TLS_DOMAIN=

# ACME and local backup
CERTBOT_VERSION=v5.7.0
ACME_EMAIL=
BACKUP_RETENTION_DAYS=180
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY_FILE=
